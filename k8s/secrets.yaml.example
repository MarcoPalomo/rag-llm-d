# Copy this file to secrets.yaml and fill in your HuggingFace token.
# Then apply: kubectl apply -f k8s/secrets.yaml
#
# Required for downloading nkpz/open_llama_7b_qlora_uncensored-gptq
apiVersion: v1
kind: Secret
metadata:
  name: llm-d-hf-token
  namespace: llm-d
type: Opaque
stringData:
  HF_TOKEN: "hf_YOUR_TOKEN_HERE"
